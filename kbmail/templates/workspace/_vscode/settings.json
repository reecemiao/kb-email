{
  // Prompt files in .github/prompts are available as /kb-* commands in Copilot Chat.
  "chat.promptFiles": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  // Let Copilot agent mode run the kbmail CLI without asking each time.
  // Remove this if you prefer to approve every command.
  "chat.tools.terminal.autoApprove": {
    "kbmail": true
  },
  // Large exported data is still readable by Copilot, just kept out of quick-open/search noise.
  "search.exclude": {
    "data/**/_raw/**": true,
    "data/**/*_files/**": true,
    "state/wiki_snapshots/**": true
  },
  "files.associations": {
    "*.mmd": "mermaid"
  }
}
